# Install as /opt/apps/bbm/.env (chmod 600). Never commit the real file.
# Use the same commit SHA for both images; digests are preferred after pulling.
BACKEND_IMAGE=ghcr.io/eng-raysonsimon/bbm-backend:REPLACE_ME
FRONTEND_IMAGE=ghcr.io/eng-raysonsimon/bbm-frontend:REPLACE_ME
POSTGRES_DB=bbm
POSTGRES_USER=bbm
POSTGRES_PASSWORD=REPLACE_ME
DJANGO_SECRET_KEY=REPLACE_ME
# Percent-encode URL-special characters in the database password.
DATABASE_URL=postgres://bbm:REPLACE_ME@db:5432/bbm
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=bbmapi.mauzo.tz
CORS_ALLOWED_ORIGINS=https://bbm.mauzo.tz
CSRF_TRUSTED_ORIGINS=https://bbmapi.mauzo.tz
FRONTEND_URL=https://bbm.mauzo.tz
SECURE_HSTS_SECONDS=3600
EMAIL_HOST=REPLACE_ME
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=REPLACE_ME
