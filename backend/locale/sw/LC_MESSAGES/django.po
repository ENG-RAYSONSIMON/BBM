#: sales/serializers.py:46
msgid "A customer with this phone number already exists."
msgstr "Tayari kuna mteja mwenye namba hii ya simu."

#: sales/serializers.py:58
msgid "A customer with this phone number already exists. Choose them instead."
msgstr "Tayari kuna mteja mwenye namba hii ya simu. Mchague yeye."

#: sales/serializers.py:92
msgid "Choose an existing customer or enter a new one, not both."
msgstr "Chagua mteja aliyepo au weka mpya, si vyote viwili."

#: sales/services.py:171
msgid "Add at least one product to the sale."
msgstr "Ongeza angalau bidhaa moja kwenye mauzo."

#: sales/services.py:179
#, python-format
msgid "%(name)s is listed twice. Use one line per product."
msgstr "%(name)s imeandikwa mara mbili. Tumia mstari mmoja kwa kila bidhaa."

#: sales/services.py:183
#, python-format
msgid "%(name)s is archived and can't be sold."
msgstr "%(name)s imewekwa pembeni, haiwezi kuuzwa."

#: sales/services.py:193
#, python-format
msgid "%(name)s: the discount must be between 0 and %(max)s."
msgstr "%(name)s: punguzo liwe kati ya 0 na %(max)s."

#: sales/services.py:223
msgid "Enter the cash received (0 or more)."
msgstr "Weka pesa uliyopokea (0 au zaidi)."

#: sales/services.py:232
msgid ""
"The cash received is less than the total. Choose the customer who owes the "
"rest."
msgstr ""
"Pesa uliyopokea ni pungufu ya jumla. Chagua mteja anayedaiwa kiasi "
"kilichobaki."

#: sales/services.py:251
#, python-format
msgid "%(name)s: only %(count)s available to sell."
msgstr "%(name)s: zimebaki %(count)s tu za kuuza."

#: sales/services.py:322
msgid "This sale is void."
msgstr "Mauzo haya yamebatilishwa."

#: sales/services.py:324
msgid "Nothing is owed on this sale."
msgstr "Hakuna deni kwenye mauzo haya."

#: sales/services.py:326
msgid "Enter the cash received."
msgstr "Weka pesa uliyopokea."

#: sales/services.py:345
msgid "Say why the sale is being voided."
msgstr "Eleza kwa nini unabatilisha mauzo haya."

#: sales/services.py:348
msgid "This sale is already void."
msgstr "Mauzo haya yameshabatilishwa."

#: sales/views.py:297
msgid "This customer has sales and can't be deleted."
msgstr "Mteja huyu ana mauzo, hawezi kufutwa."
