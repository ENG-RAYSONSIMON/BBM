# Copy to backend/.env. Values marked REPLACE_ME must be filled in.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=REPLACE_ME
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Must match POSTGRES_* in the root .env. Host "db" is the compose service.
DATABASE_URL=postgres://bbm:REPLACE_ME@db:5432/bbm

# Throttle counters (NFR-3). Required in production; without it each worker
# keeps its own in-memory counters.
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
# Used to build password reset links.
FRONTEND_URL=http://localhost:5173

# Optional overrides (defaults shown).
# PASSWORD_RESET_TIMEOUT=1800
# DEFAULT_FROM_EMAIL=no-reply@bbm.local
# LOGIN_THROTTLE_RATE=10/min
# REGISTER_THROTTLE_RATE=5/hour
# TOKEN_REFRESH_THROTTLE_RATE=30/min
# PASSWORD_RESET_THROTTLE_RATE=5/hour
